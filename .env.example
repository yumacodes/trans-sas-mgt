# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# Supabase dashboard locations are given for each value.

# ── Browser-safe values (VITE_* are bundled into the web app) ──────────────────
# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API Keys → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave as-is for local development (Vite proxies /api to the API server)
VITE_API_URL=/api/v1

# ── Server-only secrets (used by apps/api; never prefix with VITE_) ────────────
# Same Project URL as above
SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for projects still on the legacy JWT secret (Project Settings → JWT Keys).
# Leave empty if the project uses JWT signing keys; tokens are then verified via JWKS.
SUPABASE_JWT_SECRET=
# Private bucket for logos and business documents
SUPABASE_STORAGE_BUCKET=business-documents

# Connect (top bar) → ORMs → Prisma. Replace [YOUR-PASSWORD] with the database password.
# Transaction pooler, port 6543 — used by the running API
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# ── App settings ───────────────────────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Outbound email (Communication module) ──────────────────────────────────────
# Optional. Without SMTP_HOST and MAIL_FROM_EMAIL the app runs normally and the
# Communication page shows a setup notice instead of pretending messages were sent.
# Any SMTP provider works: Microsoft 365, Google Workspace, a company mail server.
SMTP_HOST=
# 587 for STARTTLS (default), 465 for implicit TLS
SMTP_PORT=587
# Leave empty to follow the port (true on 465); set true/false to force it
SMTP_SECURE=
# Mailbox credentials. Leave empty only for a relay that needs no authentication.
SMTP_USER=
SMTP_PASS=
# Address messages are sent from; must be one the mail server allows
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Optional address for replies, when it differs from the sending address
MAIL_REPLY_TO=
