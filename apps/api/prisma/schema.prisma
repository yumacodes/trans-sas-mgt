// Medical equipment business management system: database schema.
//
// Conventions
// - UUID primary keys; table names are snake_case via @@map.
// - Money: Decimal(18,2) for prices/totals, Decimal(18,4) for unit costs. Never Float.
// - Quantities: Decimal(18,3) so non-unit measures (litres, kg) work.
// - Business dates use @db.Date; events use timestamptz.
// - Business references use onDelete: Restrict. Records are archived/deactivated, not deleted.
// - Raw-SQL migrations add what Prisma cannot express: the pg_trgm extension, CHECK
//   constraints, append-only triggers and RLS. Avoid expression or partial indexes in
//   raw SQL: Prisma cannot represent them and would drop them in the next migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

/// Application profile for a Supabase Auth user. Supabase Auth is the source of identity
/// and credentials; no passwords are stored here.
model UserProfile {
  id            String    @id @default(uuid()) @db.Uuid
  authUserId    String    @unique @db.Uuid
  email         String    @unique
  /// Sign-in name, stored lower-case. Resolved to the email by POST /auth/login.
  username      String    @unique
  fullName      String
  phone         String?
  isActive      Boolean   @default(true)
  /// True until the user replaces the default password they were given.
  mustChangePassword Boolean @default(false)
  deactivatedAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  roles    UserRole[]
  branches UserBranchAssignment[]

  auditEntries          AuditLog[]
  ownedClients          Client[]               @relation("ClientAccountOwner")
  createdClients        Client[]               @relation("ClientCreatedBy")
  createdRegistrations  ClientRegistration[]
  createdStockItems     StockItem[]
  stockMovements        StockMovement[]
  uploadedFiles         FileRecord[]
  idempotencyRecords    IdempotencyRecord[]
  passwordResetRequests PasswordResetRequest[] @relation("ResetRequestUser")
  resolvedResetRequests PasswordResetRequest[] @relation("ResetRequestResolver")
  managedBranches       Branch[]               @relation("BranchManager")
  sentMessages          Message[]
  proformas             Proforma[]
  recordedExpenses      Expense[]              @relation("ExpenseRecordedBy")
  approvedExpenses      Expense[]              @relation("ExpenseApprovedBy")
  tenders               Tender[]
  acceptanceLetters     AcceptanceLetter[]
  sales                 Sale[]
  waybills              Waybill[]
  payments              Payment[]
  approvedStockItems    StockItem[]            @relation("StockItemApprovedBy")
  notifications         Notification[]
  suppliers             Supplier[]
  purchases             Purchase[]
  goodsReceipts         GoodsReceipt[]

  @@index([isActive])
  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable machine key (e.g. "admin"). System roles are seeded; custom roles get a slug.
  key         String   @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catalogue of permission keys, synchronised from packages/shared/src/permissions.ts.
model Permission {
  key         String @id
  group       String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserBranchAssignment {
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_assignments")
}

/// Append-only audit trail. A database trigger rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor UserProfile? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Stores the outcome of critical mutations so retried requests with the same
/// Idempotency-Key return the original result instead of repeating the operation.
model IdempotencyRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// ───────────────────────────── Company & branches ─────────────────────────────

/// Single-row table (enforced by the unique singleton flag).
model CompanyProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  singleton          Boolean  @unique @default(true)
  name               String
  legalName          String?
  email              String?
  phone              String?
  website            String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  region             String?
  country            String?
  taxId              String?
  registrationNumber String?
  defaultCurrency    String   @db.Char(3)
  /// Validated by companySettingsSchema in packages/shared.
  settings           Json
  logoFileId         String?  @unique @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  logo FileRecord? @relation(fields: [logoFileId], references: [id], onDelete: SetNull)

  @@map("company_profile")
}

/// Gap-free counters for business document numbers, locked per row while incrementing.
model DocumentSequence {
  id        String   @id @default(uuid()) @db.Uuid
  docType   String
  /// "global" or a branch id when numbering is branch-specific.
  scopeKey  String
  /// Calendar year when numbering resets yearly, otherwise 0.
  year      Int
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([docType, scopeKey, year])
  @@map("document_sequences")
}

model Branch {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  addressLine1  String?
  city          String?
  region        String?
  phone         String?
  email         String?
  /// Staff member who manages the branch; the "branch managers" message audience.
  managerUserId String?  @db.Uuid
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  manager         UserProfile?           @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  userAssignments UserBranchAssignment[]
  clients         Client[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  expenses        Expense[]
  proformas       Proforma[]
  tenders         Tender[]
  acceptanceLetters AcceptanceLetter[]
  sales           Sale[]
  waybills        Waybill[]
  payments        Payment[]
  purchases       Purchase[]
  goodsReceipts   GoodsReceipt[]

  @@index([managerUserId])
  @@map("branches")
}

// ───────────────────────────── Files ─────────────────────────────

/// Metadata for objects in Supabase Storage. Downloads are authorised by the API
/// against the owning record, never by the object path alone.
model FileRecord {
  id           String    @id @default(uuid()) @db.Uuid
  bucket       String
  path         String
  originalName String
  mimeType     String
  sizeBytes    Int
  category     String
  ownerType    String
  ownerId      String?
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  uploadedBy     UserProfile     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  companyLogo    CompanyProfile?
  stockItemImage StockItemImage?

  @@unique([bucket, path])
  @@index([ownerType, ownerId])
  @@map("file_records")
}

// ───────────────────────────── Clients ─────────────────────────────

enum OrganizationType {
  public_hospital
  private_hospital
  clinic
  laboratory
  pharmacy
  government_agency
  ngo
  distributor
  individual
  other
}

enum ClientStatus {
  active
  archived
}

model Client {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique
  name             String
  organizationType OrganizationType
  contactPerson    String?
  email            String?
  phone            String?
  billingAddress   String?
  deliveryAddress  String?
  taxId            String?
  notes            String?
  status           ClientStatus     @default(active)
  archivedAt       DateTime?        @db.Timestamptz(6)
  branchId         String?          @db.Uuid
  accountOwnerId   String?          @db.Uuid
  createdById      String           @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accountOwner      UserProfile?         @relation("ClientAccountOwner", fields: [accountOwnerId], references: [id], onDelete: Restrict)
  createdBy         UserProfile          @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  registrations     ClientRegistration[]
  sales             Sale[]
  waybills          Waybill[]
  proformas         Proforma[]
  tenders           Tender[]
  acceptanceLetters AcceptanceLetter[]

  @@index([status])
  @@index([organizationType])
  @@index([branchId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "clients_name_trgm", type: Gin)
  @@index([code(ops: raw("gin_trgm_ops"))], map: "clients_code_trgm", type: Gin)
  @@map("clients")
}

enum RegistrationStatus {
  pending
  active
  suspended
  expired
  revoked
}

/// Registration lifecycle for a client. A "registered client" is a Client with an
/// active registration; the client identity is never duplicated. At most one active
/// registration per client: the API locks the client row while creating or activating
/// a registration, then checks for another active one.
model ClientRegistration {
  id                 String             @id @default(uuid()) @db.Uuid
  clientId           String             @db.Uuid
  registrationNumber String             @unique
  registeredOn       DateTime           @db.Date
  validUntil         DateTime?          @db.Date
  status             RegistrationStatus @default(active)
  statusChangedAt    DateTime           @default(now()) @db.Timestamptz(6)
  notes              String?
  createdById        String             @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy UserProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([status])
  @@index([registrationNumber(ops: raw("gin_trgm_ops"))], map: "client_registrations_number_trgm", type: Gin)
  @@map("client_registrations")
}

// ───────────────────────────── Catalogue & inventory ─────────────────────────────

enum TrackingMode {
  none
  serial
  batch
}

enum StockMovementType {
  opening_balance
  purchase_receipt
  sale_issue
  sale_return
  adjustment_in
  adjustment_out
  transfer_in
  transfer_out
}

model StockCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  items StockItem[]

  @@map("stock_categories")
}

model StockItem {
  id             String       @id @default(uuid()) @db.Uuid
  /// Stored upper-cased; unique.
  sku            String       @unique
  name           String
  description    String?
  categoryId     String?      @db.Uuid
  brand          String?
  model          String?
  unit           String
  purchaseCost   Decimal?     @db.Decimal(18, 4)
  sellingPrice   Decimal      @db.Decimal(18, 2)
  reorderLevel   Int          @default(0)
  trackingMode   TrackingMode @default(none)
  warrantyMonths Int?
  tracksExpiry   Boolean      @default(false)
  isActive       Boolean      @default(true)
  /// A new item from someone who can't approve stays pending and can't go on documents.
  approvalStatus StockApproval @default(approved)
  approvedById   String?      @db.Uuid
  approvedAt     DateTime?    @db.Timestamptz(6)
  rejectionReason String?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  category      StockCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     UserProfile      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    UserProfile?     @relation("StockItemApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  balances      StockBalance[]
  movements     StockMovement[]
  images        StockItemImage[]
  proformaItems ProformaItem[]
  tenderItems   TenderItem[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  waybillItems  WaybillItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([approvalStatus])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "stock_items_name_trgm", type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "stock_items_sku_trgm", type: Gin)
  @@map("stock_items")
}

/// Product photographs for a stock item, ordered by `position`; the lowest position is
/// the thumbnail. The image bytes live in Supabase Storage via FileRecord.
model StockItemImage {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @db.Uuid
  fileId    String   @unique @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  item StockItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file FileRecord @relation(fields: [fileId], references: [id], onDelete: Restrict)

  // Positions are not unique per item on purpose: reordering renumbers several rows in
  // one transaction, and a unique constraint would reject the intermediate states.
  @@index([itemId, position])
  @@map("stock_item_images")
}

/// Cached on-hand quantity per item and branch. The StockMovement ledger is the source
/// of truth; this row is updated in the same transaction as each movement (row-locked)
/// and can be rebuilt from the ledger (see docs/architecture.md, "Stock reconciliation").
model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  itemId           String   @db.Uuid
  branchId         String   @db.Uuid
  quantityOnHand   Decimal  @default(0) @db.Decimal(18, 3)
  quantityReserved Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  branch Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("stock_balances")
}

/// Append-only inventory ledger. Quantity is signed (+ in, − out). A trigger rejects
/// UPDATE and DELETE; corrections are recorded as new movements.
model StockMovement {
  id         String            @id @default(uuid()) @db.Uuid
  itemId     String            @db.Uuid
  branchId   String            @db.Uuid
  type       StockMovementType
  quantity   Decimal           @db.Decimal(18, 3)
  unitCost   Decimal?          @db.Decimal(18, 4)
  sourceType String?
  sourceId   String?
  reference  String?
  note       String?
  actorId    String?           @db.Uuid
  occurredAt DateTime          @default(now()) @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)

  item   StockItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor  UserProfile? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([itemId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

/// A user asked an administrator to reset their password. Open while `resolvedAt` is null;
/// the database allows only one open request per user.
model PasswordResetRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime? @db.Timestamptz(6)
  resolvedById String?   @db.Uuid

  user       UserProfile  @relation("ResetRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy UserProfile? @relation("ResetRequestResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([resolvedAt, createdAt])
  @@map("password_reset_requests")
}

// ───────────────────────────── Communication ─────────────────────────────

enum MessageAudience {
  clients
  users
  branch_managers
}

enum MessageStatus {
  queued
  sending
  sent
  partially_sent
  failed
}

enum MessageRecipientKind {
  client
  user
  branch_manager
}

enum MessageRecipientStatus {
  pending
  sent
  failed
  skipped
}

/// One composed message and its delivery outcome. The recipient list is resolved on the
/// server from `audience` + `filters` when the message is sent and then frozen, so this
/// is a record of what was actually sent to whom.
model Message {
  id             String          @id @default(uuid()) @db.Uuid
  audience       MessageAudience
  /// Audience filters as validated by messageFiltersSchema in packages/shared.
  filters        Json
  subject        String
  body           String
  status         MessageStatus   @default(queued)
  recipientCount Int             @default(0)
  sentCount      Int             @default(0)
  failedCount    Int             @default(0)
  skippedCount   Int             @default(0)
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?       @db.Timestamptz(6)

  createdBy  UserProfile        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  recipients MessageRecipient[]

  @@index([createdAt])
  @@index([status])
  @@map("messages")
}

/// Per-recipient delivery record. The name and email address are copies taken when the
/// message was sent: they must keep showing what was sent, even if the client, user or
/// branch is edited afterwards. `recipientId` is therefore a plain reference, not a
/// foreign key (the same reasoning as audit_logs.entityId).
model MessageRecipient {
  id          String                 @id @default(uuid()) @db.Uuid
  messageId   String                 @db.Uuid
  kind        MessageRecipientKind
  recipientId String?                @db.Uuid
  name        String
  email       String?
  /// Merge-field values for this recipient, applied to the message template when sent.
  values      Json                   @default("{}")
  status      MessageRecipientStatus @default(pending)
  /// Reason a delivery failed, in language a business user can act on.
  error       String?
  sentAt      DateTime?              @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, status])
  @@index([kind, recipientId])
  @@map("message_recipients")
}

// ───────────────────────────── Proformas ─────────────────────────────

enum ProformaStatus {
  draft
  issued
  accepted
  rejected
  expired
}

/// Quotation sent to a customer. Not a sale: it moves no stock and recognises no revenue.
/// Customer details are copied onto the document so it stays as issued even if the client
/// record is edited later; `clientId` links it back to the directory when one was chosen.
/// Totals are stored (calculated server-side with decimal arithmetic) so reports and the
/// PDF always agree with what was issued.
model Proforma {
  id              String         @id @default(uuid()) @db.Uuid
  number          String         @unique
  issueDate       DateTime       @db.Date
  currency        String         @db.Char(3)
  clientId        String?        @db.Uuid
  customerName    String
  customerAddress String?
  customerEmail   String?
  customerPhone   String?
  vatRate         Decimal        @db.Decimal(5, 2)
  taxRate         Decimal        @db.Decimal(5, 2)
  subtotal        Decimal        @db.Decimal(18, 2)
  vatAmount       Decimal        @db.Decimal(18, 2)
  taxAmount       Decimal        @db.Decimal(18, 2)
  total           Decimal        @db.Decimal(18, 2)
  notes           String?
  status          ProformaStatus @default(draft)
  emailedAt       DateTime?      @db.Timestamptz(6)
  branchId        String?        @db.Uuid
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy UserProfile    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     ProformaItem[]
  branch    Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales     Sale[]

  @@index([branchId])
  @@index([issueDate])
  @@index([status])
  @@index([clientId])
  @@index([customerName(ops: raw("gin_trgm_ops"))], map: "proformas_customer_trgm", type: Gin)
  @@index([number(ops: raw("gin_trgm_ops"))], map: "proformas_number_trgm", type: Gin)
  @@map("proformas")
}

model ProformaItem {
  id          String  @id @default(uuid()) @db.Uuid
  proformaId  String  @db.Uuid
  position    Int
  stockItemId String? @db.Uuid
  name        String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  proforma  Proforma   @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([proformaId, position])
  @@index([stockItemId])
  @@map("proforma_items")
}

enum ExpenseKind {
  general
  tender_in
  tender_out
}

enum ExpenseStatus {
  pending
  approved
  rejected
  voided
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  mobile_money
  card
  other
}

/// General expenses and tender-related incoming/outgoing transactions. One table, kept
/// apart by `kind`; amounts are never summed across kinds or currencies.
model Expense {
  id               String        @id @default(uuid()) @db.Uuid
  number           String        @unique
  kind             ExpenseKind
  transactionDate  DateTime      @db.Date
  currency         String        @db.Char(3)
  amount           Decimal       @db.Decimal(18, 2)
  category         String
  counterparty     String?
  tenderReference  String?
  paymentMethod    PaymentMethod
  paymentReference String?
  description      String?
  status           ExpenseStatus @default(pending)
  statusReason     String?
  branchId         String?       @db.Uuid
  createdById      String        @db.Uuid
  approvedById     String?       @db.Uuid
  approvedAt       DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy  UserProfile  @relation("ExpenseRecordedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy UserProfile? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([kind, transactionDate])
  @@index([kind, status])
  @@index([branchId])
  @@index([number(ops: raw("gin_trgm_ops"))], map: "expenses_number_trgm", type: Gin)
  @@index([counterparty(ops: raw("gin_trgm_ops"))], map: "expenses_counterparty_trgm", type: Gin)
  @@map("expenses")
}

enum TenderStatus {
  draft
  submitted
  awarded
  not_awarded
  cancelled
}

/// A tender price schedule: the priced items submitted for one tender lot.
model Tender {
  id                 String       @id @default(uuid()) @db.Uuid
  number             String       @unique
  scheduleDate       DateTime     @db.Date
  tenderReference    String?
  submissionDeadline DateTime?    @db.Date
  clientId           String?      @db.Uuid
  customerName       String
  customerAddress    String?
  lot                String?
  currency           String       @db.Char(3)
  taxLabel           String
  taxRate            Decimal      @db.Decimal(5, 2)
  subtotal           Decimal      @db.Decimal(18, 2)
  taxAmount          Decimal      @db.Decimal(18, 2)
  total              Decimal      @db.Decimal(18, 2)
  notes              String?
  status             TenderStatus @default(draft)
  branchId           String?      @db.Uuid
  createdById        String       @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy         UserProfile        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items             TenderItem[]
  acceptanceLetters AcceptanceLetter[]
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales             Sale[]

  @@index([branchId])
  @@index([scheduleDate])
  @@index([status])
  @@index([clientId])
  @@index([customerName(ops: raw("gin_trgm_ops"))], map: "tenders_customer_trgm", type: Gin)
  @@index([number(ops: raw("gin_trgm_ops"))], map: "tenders_number_trgm", type: Gin)
  @@map("tenders")
}

model TenderItem {
  id              String  @id @default(uuid()) @db.Uuid
  tenderId        String  @db.Uuid
  position        Int
  stockItemId     String? @db.Uuid
  description     String
  quantity        Decimal @db.Decimal(18, 3)
  unit            String
  unitPrice       Decimal @db.Decimal(18, 2)
  amount          Decimal @db.Decimal(18, 2)
  amountWithTax   Decimal @db.Decimal(18, 2)
  countryOfOrigin String?
  manufacturer    String?
  brand           String?
  expiryDate      String?

  tender    Tender     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([tenderId, position])
  @@index([stockItemId])
  @@map("tender_items")
}

enum AcceptanceStatus {
  draft
  issued
  cancelled
}

/// The company's written acceptance of a contract award.
model AcceptanceLetter {
  id                String           @id @default(uuid()) @db.Uuid
  number            String           @unique
  letterDate        DateTime         @db.Date
  yourReference     String?
  clientId          String?          @db.Uuid
  recipientName     String
  recipientAddress  String?
  contractNumber    String
  awardLetterDate   DateTime?        @db.Date
  supplyDescription String
  subject           String
  body              String
  signatoryName     String
  signatoryTitle    String?
  tenderId          String?          @db.Uuid
  status            AcceptanceStatus @default(draft)
  branchId          String?          @db.Uuid
  createdById       String           @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tender    Tender?     @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  createdBy UserProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  branch    Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([letterDate])
  @@index([status])
  @@index([clientId])
  @@index([tenderId])
  @@index([recipientName(ops: raw("gin_trgm_ops"))], map: "acceptance_letters_recipient_trgm", type: Gin)
  @@index([number(ops: raw("gin_trgm_ops"))], map: "acceptance_letters_number_trgm", type: Gin)
  @@map("acceptance_letters")
}

enum SaleStatus {
  draft
  confirmed
  cancelled
}

/// Confirming a sale issues its stock once; cancelling a confirmed sale returns it.
model Sale {
  id              String     @id @default(uuid()) @db.Uuid
  number          String     @unique
  saleDate        DateTime   @db.Date
  dueDate         DateTime?  @db.Date
  currency        String     @db.Char(3)
  branchId        String     @db.Uuid
  clientId        String?    @db.Uuid
  customerName    String
  customerAddress String?
  customerEmail   String?
  customerPhone   String?
  taxRate         Decimal    @db.Decimal(5, 2)
  subtotal        Decimal    @db.Decimal(18, 2)
  taxAmount       Decimal    @db.Decimal(18, 2)
  total           Decimal    @db.Decimal(18, 2)
  notes           String?
  status          SaleStatus @default(draft)
  cancelReason    String?
  confirmedAt     DateTime?  @db.Timestamptz(6)
  proformaId      String?    @db.Uuid
  tenderId        String?    @db.Uuid
  createdById     String     @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proforma  Proforma?   @relation(fields: [proformaId], references: [id], onDelete: Restrict)
  tender    Tender?     @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  createdBy UserProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleItem[]
  waybills  Waybill[]
  payments  Payment[]

  @@index([branchId])
  @@index([saleDate])
  @@index([status])
  @@index([clientId])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  position    Int
  /// Null for a line with no stock item, such as a service; it never moves stock.
  stockItemId String? @db.Uuid
  name        String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem    StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  waybillItems WaybillItem[]

  @@index([saleId, position])
  @@index([stockItemId])
  @@map("sale_items")
}

enum WaybillStatus {
  draft
  dispatched
  delivered
  cancelled
}

/// A waybill linked to a sale never moves stock. One with no sale issues it at dispatch.
model Waybill {
  id              String        @id @default(uuid()) @db.Uuid
  number          String        @unique
  branchId        String        @db.Uuid
  saleId          String?       @db.Uuid
  clientId        String?       @db.Uuid
  recipientName   String
  deliveryAddress String?
  deliveryDate    DateTime      @db.Date
  carrier         String?
  vehicleNumber   String?
  receivedBy      String?
  notes           String?
  status          WaybillStatus @default(draft)
  stockIssued     Boolean       @default(false)
  dispatchedAt    DateTime?     @db.Timestamptz(6)
  deliveredAt     DateTime?     @db.Timestamptz(6)
  createdById     String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale      Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy UserProfile   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     WaybillItem[]

  @@index([branchId])
  @@index([saleId])
  @@index([status])
  @@index([deliveryDate])
  @@map("waybills")
}

model WaybillItem {
  id          String  @id @default(uuid()) @db.Uuid
  waybillId   String  @db.Uuid
  position    Int
  saleItemId  String? @db.Uuid
  stockItemId String? @db.Uuid
  name        String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String

  waybill   Waybill    @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  saleItem  SaleItem?  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([waybillId, position])
  @@index([saleItemId])
  @@map("waybill_items")
}

enum PaymentStatus {
  posted
  reversed
}

/// Customer receipt against a confirmed sale. Never edited: mistakes are reversed.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  number            String        @unique
  saleId            String        @db.Uuid
  branchId          String        @db.Uuid
  paymentDate       DateTime      @db.Date
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @db.Char(3)
  method            PaymentMethod
  externalReference String?
  notes             String?
  status            PaymentStatus @default(posted)
  reverseReason     String?
  reversedAt        DateTime?     @db.Timestamptz(6)
  createdById       String        @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy UserProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([branchId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

enum StockApproval {
  pending
  approved
  rejected
}

/// In-app notice for one user. `dedupeKey` keeps a repeated event from notifying twice.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Shared by every branch, and separate from clients.
model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  notes         String?
  isActive      Boolean  @default(true)
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  createdBy UserProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  purchases Purchase[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

enum PurchaseStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

/// Stock rises only through a goods receipt, never from the purchase itself.
model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  number            String         @unique
  branchId          String         @db.Uuid
  supplierId        String         @db.Uuid
  purchaseDate      DateTime       @db.Date
  expectedDate      DateTime?      @db.Date
  supplierReference String?
  currency          String         @db.Char(3)
  taxRate           Decimal        @db.Decimal(5, 2)
  subtotal          Decimal        @db.Decimal(18, 2)
  taxAmount         Decimal        @db.Decimal(18, 2)
  total             Decimal        @db.Decimal(18, 2)
  notes             String?
  status            PurchaseStatus @default(draft)
  createdById       String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy UserProfile    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     PurchaseItem[]
  receipts  GoodsReceipt[]

  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseId       String  @db.Uuid
  position         Int
  stockItemId      String  @db.Uuid
  name             String
  quantity         Decimal @db.Decimal(18, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unit             String
  unitCost         Decimal @db.Decimal(18, 4)
  amount           Decimal @db.Decimal(18, 2)

  purchase  Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  received  GoodsReceiptLine[]

  @@index([purchaseId, position])
  @@index([stockItemId])
  @@map("purchase_items")
}

model GoodsReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  purchaseId   String   @db.Uuid
  branchId     String   @db.Uuid
  receivedDate DateTime @db.Date
  note         String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  purchase  Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy UserProfile        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@index([purchaseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String  @id @default(uuid()) @db.Uuid
  receiptId      String  @db.Uuid
  purchaseItemId String  @db.Uuid
  quantity       Decimal @db.Decimal(18, 3)

  receipt      GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([purchaseItemId])
  @@map("goods_receipt_lines")
}
